# ── Gemini failover chain (optional — app runs fully with ZERO keys) ──────────
GEMINI_PROVIDER_1_API_KEY=
GEMINI_PROVIDER_2_API_KEY=
GEMINI_PROVIDER_3_API_KEY=
GEMINI_PROVIDER_4_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MAX_LLM_ATTEMPTS=4

# ── Spatial/vector database ─────────────────────────────────────────────────
# Hero mode: PostgreSQL + PostGIS + pgvector (start docker-compose first).
# Leave EMPTY (default) → the app auto-uses embedded DuckDB at data/geoready.duckdb
# (same SQL, same tables, real vector search — no Docker needed).
DATABASE_URL=
# DATABASE_URL=postgresql://geoready:geoready@localhost:5432/geoready

# Embedded fallback location (only used when DATABASE_URL is empty/unreachable)
DUCKDB_PATH=data/geoready.duckdb

# ── Local everything (no cloud required) ────────────────────────────────────
# Embeddings: sentence-transformers/all-MiniLM-L6-v2 via fastembed (ONNX, 384-dim)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
